{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Stores information about users within the AI Academic Assistant system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "externalAuthId": {
          "type": "string",
          "description": "Reference to the unique identifier from an external authentication system."
        },
        "firstName": {
          "type": "string",
          "description": "The first name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "The last name of the user."
        },
        "email": {
          "type": "string",
          "description": "The email address of the user.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The role of the user (student/teacher).",
          "enum": ["student", "teacher"]
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the user profile was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the user profile was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "externalAuthId",
        "firstName",
        "lastName",
        "email",
        "role",
        "createdAt"
      ]
    },
    "Document": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Document",
      "type": "object",
      "description": "Represents an uploaded study material (PDF, PPTX, Image) processed by the Vision AI.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Document."
        },
        "uploaderId": {
          "type": "string",
          "description": "Reference to the UserProfile of the uploader."
        },
        "title": {
          "type": "string",
          "description": "Title of the document."
        },
        "fileUrl": {
          "type": "string",
          "description": "The URL where the document is stored.",
          "format": "uri"
        },
        "fileType": {
          "type": "string",
          "description": "MIME type (e.g., 'application/pdf')."
        },
        "uploadDate": {
          "type": "string",
          "description": "Timestamp of upload.",
          "format": "date-time"
        },
        "processedStatus": {
          "type": "string",
          "description": "AI processing status."
        }
      },
      "required": [
        "id",
        "uploaderId",
        "title",
        "fileUrl",
        "fileType",
        "uploadDate",
        "processedStatus"
      ]
    },
    "Quiz": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Quiz",
      "type": "object",
      "description": "Represents a quiz generated by the AI.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier."
        },
        "creatorId": {
          "type": "string",
          "description": "Reference to the creator."
        },
        "title": {
          "type": "string",
          "description": "Title of the quiz."
        },
        "difficulty": {
          "type": "string",
          "enum": ["Easy", "Medium", "Hard"]
        },
        "questionCount": {
          "type": "number"
        },
        "generationDate": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "creatorId",
        "title",
        "difficulty",
        "questionCount",
        "generationDate"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/userProfiles/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "User profiles for the Academic Assistant system.",
          "params": [
            {
              "name": "userId",
              "description": "Auth UID."
            }
          ]
        }
      }
    ]
  }
}
